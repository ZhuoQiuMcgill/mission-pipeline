#!/usr/bin/env python3
"""mp — Mission Pipeline entry point.

  --bridge-stdio    serve exactly one JSON request from a native Windows client
  MP_COMPAT_V3=1    the frozen schema-3 dispatcher (regression and replay only;
                    it refuses a ledger that already has a schema-4 writer)
  otherwise         the schema-4 CLI

Every line of substance lives in mp_runtime/: the v4 CLI in cli.py, the v3
dispatcher in legacy_v3.py. This file only chooses between them.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from mp_runtime.process import RuntimeRefusal, json_bytes, utf8_console

utf8_console()


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv == ["--bridge-stdio"]:
        from mp_runtime.bridge import serve_one
        try:
            sys.stdout.buffer.write(json_bytes(serve_one()))
            return 0
        except RuntimeRefusal as exc:
            sys.stdout.buffer.write(json_bytes(exc.body()))
            return 3
    if os.environ.get("MP_COMPAT_V3") == "1":
        from mp_runtime.legacy_v3 import main as v3_main
        return v3_main(argv)
    from mp_runtime.cli import main as v4_main
    return v4_main(argv)


if __name__ == "__main__":
    raise SystemExit(main())
