#!/bin/sh
# `mp` for a harness that puts this directory on its PATH (the optional Claude Code plugin does):
# runs the engine's launcher next to it. The usual install is `npm install -g <engine>`.
here=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
exec "${MP_NODE:-node}" "$here/../../bin/mp.mjs" "$@"
