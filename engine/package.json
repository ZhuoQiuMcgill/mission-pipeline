{
  "name": "@mission-pipeline/engine",
  "version": "4.1.1",
  "private": true,
  "description": "Mission Pipeline 4.1: the mp command line over a neutral project memory (SQLite skeleton + Markdown leaves), role descriptions and a process. Any harness and model can fill any seat.",
  "type": "module",
  "bin": {
    "mp": "bin/mp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:cli": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/cli-*.test.ts\"",
    "mp": "node bin/mp.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
